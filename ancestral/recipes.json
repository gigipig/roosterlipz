      "culture_id": "aboriginal_aus",
      "recipes": [
        {
          "id": "aboriginal_aus_1",
          "name": "Roasted Kangaroo with Native Herbs",
          "description": "Lean game roasted with bush herbs — a staple protein of Aboriginal Australian diets for tens of thousands of years.",
          "category": "protein",
          "ingredients": [
            { "item": "kangaroo loin", "amount": "500g", "note": "Substitute: venison or grass-fed beef" },
            { "item": "native pepperberry", "amount": "1 tsp", "note": "Substitute: black pepper + juniper" },
            { "item": "lemon myrtle", "amount": "1 tsp", "note": "Substitute: lemongrass" },
            { "item": "macadamia oil", "amount": "2 tbsp" },
            { "item": "native tubers", "amount": "300g", "note": "Substitute: sweet potato" }
          ],
          "instructions": [
            "Season kangaroo loin with pepperberry and lemon myrtle.",
            "Sear in macadamia oil over high heat, 2 minutes per side.",
            "Roast at 200°C (400°F) for 12-15 minutes for medium-rare.",
            "Rest for 5 minutes before slicing.",
            "Serve with roasted native tubers."
          ],
          "prep_time_min": 15,
          "cook_time_min": 20,
          "servings": 4,
          "genetic_tags": ["iron_metabolism", "vitamin_d_metabolism"],
          "dietary_flags": ["dairy-free", "gluten-free", "high-protein", "anti-inflammatory"],
          "health_benefits": "Kangaroo is extremely lean (2% fat) and high in iron, zinc, and conjugated linoleic acid. Aligns with hunter-gatherer metabolic adaptations.",
          "modern_substitutes": { "kangaroo": "venison or grass-fed beef", "native tubers": "sweet potato or parsnip" },
          "source_tradition": "Aboriginal Australians have hunted kangaroo for over 50,000 years. Traditionally cooked in ground ovens or over open coals."
        },
        {
          "id": "aboriginal_aus_2",
          "name": "Smoked Fish with Bush Tomato",
          "description": "Coastal Aboriginal preparation of smoked fish with native fruits and seeds.",
          "category": "protein",
          "ingredients": [
            { "item": "fish", "amount": "4 fillets", "note": "Barramundi, snapper, or any firm white fish" },
            { "item": "bush tomato", "amount": "2 tbsp ground", "note": "Substitute: sun-dried tomato + smoked paprika" },
            { "item": "wattleseed", "amount": "1 tbsp", "note": "Substitute: roasted hazelnut meal" },
            { "item": "sea salt", "amount": "1 tsp" },
            { "item": "eucalyptus leaves", "amount": "handful", "note": "For smoking; substitute: hickory chips" }
          ],
          "instructions": [
            "Rub fish fillets with ground bush tomato, wattleseed, and salt.",
            "Cold-smoke over eucalyptus or wood chips for 20 minutes, or oven-roast at 180°C (350°F) for 15 minutes.",
            "Serve with foraged greens or a simple salad."
          ],
          "prep_time_min": 10,
          "cook_time_min": 20,
          "servings": 4,
          "genetic_tags": ["pufa_metabolism", "vitamin_d_metabolism"],
          "dietary_flags": ["dairy-free", "gluten-free", "high-protein"],
          "health_benefits": "Rich in omega-3 fatty acids and vitamin D. Smoking is one of the oldest preservation methods, retaining nutrients while adding bioavailable compounds.",
          "modern_substitutes": { "bush tomato": "sun-dried tomato + smoked paprika", "wattleseed": "hazelnut meal" },
          "source_tradition": "Coastal Aboriginal groups smoked fish to preserve it for inland trade and seasonal travel."
        }
      ]
