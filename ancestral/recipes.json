{
  "version": "1.0",
  "note": "Ancestral recipe database. Each entry is keyed by culture ID (matching diets.json). Recipes emphasize traditional, whole-food preparation methods aligned with ancestral dietary patterns and genetic adaptations.",
  "schema": {
    "id": "Unique recipe identifier: {culture_id}_{index}",
    "culture_id": "References diets.json culture ID",
    "name": "Recipe name",
    "description": "Brief description of the dish and its ancestral significance",
    "category": "One of: staple | protein | side | soup_stew | fermented | snack | beverage",
    "ingredients": [
      {
        "item": "Ingredient name (should match diets.json food items where possible)",
        "amount": "Quantity string, e.g. '2 cups', '500g'",
        "note": "Optional: substitution or sourcing tip"
      }
    ],
    "instructions": ["Step-by-step preparation as array of strings"],
    "prep_time_min": "Estimated prep time in minutes",
    "cook_time_min": "Estimated cook time in minutes",
    "servings": "Number of servings",
    "genetic_tags": ["Array of genetic trait IDs from genetics.json, e.g. 'lactase_persistence', 'starch_digestion', 'pufa_metabolism'"],
    "dietary_flags": ["Array: 'dairy-free', 'gluten-free', 'high-protein', 'high-fiber', 'fermented', 'anti-inflammatory', 'low-carb'"],
    "health_benefits": "Short note on nutritional/health relevance tied to ancestral adaptation",
    "modern_substitutes": { "traditional_ingredient": "modern alternative" },
    "source_tradition": "Brief anthropological context for the dish"
  },
