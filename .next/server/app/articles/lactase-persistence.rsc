1d:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":["Bersaglieri et al. (2004) — ",["$","em","em-0",{"children":"Genetic signatures of strong recent positive selection at the lactase gene"}],". American Journal of Human Genetics"]}],"\n",["$","li","li-1",{"children":["Enattah et al. (2002) — ",["$","em","em-0",{"children":"Identification of a variant associated with adult-type hypolactasia"}],". Nature Genetics"]}],"\n",["$","li","li-2",{"children":["Tishkoff et al. (2007) — ",["$","em","em-0",{"children":"Convergent adaptation of human lactase persistence in Africa and Europe"}],". Nature Genetics"]}],"\n"]}]
